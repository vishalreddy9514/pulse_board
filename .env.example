# ---------------------------------------------------------------------------
# PulseBoard local environment. Copy to .env before running docker compose up.
# Every service reads its config from the environment; nothing is hard-coded.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=pulseboard
POSTGRES_PASSWORD=pulseboard
POSTGRES_DB=pulseboard
# Host/port as seen from inside the compose network.
DATABASE_URL=postgres://pulseboard:pulseboard@postgres:5432/pulseboard

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379
# Channel the producer publishes to and the backend subscribes to.
REDIS_EVENT_CHANNEL=pulseboard:events

# --- Backend --------------------------------------------------------------
PORT=4000
NODE_ENV=development
# Change this in any deployed environment. Minimum 32 characters.
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma-separated list of origins allowed to call the API / open a socket.
CORS_ORIGIN=http://localhost:5173
# How many recent events the backend keeps in its Redis-backed feed cache.
EVENT_FEED_SIZE=50
# Seeded demo account created on first boot (omit both to skip seeding).
SEED_USER_EMAIL=demo@pulseboard.dev
SEED_USER_PASSWORD=demo1234

# --- Alerting thresholds --------------------------------------------------
# Revenue (in the last 60s) above this value raises a "spike" alert.
ALERT_REVENUE_SPIKE=5000
# Revenue (in the last 60s) below this value raises a "drop" alert.
ALERT_REVENUE_DROP=200
# Orders per minute above this value raises a "surge" alert.
ALERT_ORDERS_SURGE=90

# --- Producer -------------------------------------------------------------
# Mean interval between generated events, in milliseconds.
PRODUCER_INTERVAL_MS=450
# Multiplies event volume; 1 = normal traffic, 5 = busy Friday.
PRODUCER_BURST_FACTOR=1

# --- Frontend (build-time, Vite) -----------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
