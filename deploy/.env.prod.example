# Production environment for deploy/docker-compose.prod.yml.
# Copy to .env in the repository root and fill in the four marked values.

# --- Required ---------------------------------------------------------------
# The URL people will open. With a domain: https://pulseboard.example.com
# With only an IP address: http://203.0.113.10
PUBLIC_URL=http://CHANGE-ME

# What Caddy listens on. A hostname gets an automatic Let's Encrypt
# certificate; ":80" serves plain HTTP, which is the only option for a bare IP.
CADDY_SITE_ADDRESS=:80

# Generate both of these, do not invent them by hand:
#   openssl rand -hex 16   # POSTGRES_PASSWORD
#   openssl rand -hex 32   # JWT_SECRET
POSTGRES_PASSWORD=CHANGE-ME
JWT_SECRET=CHANGE-ME

# --- Optional ---------------------------------------------------------------
POSTGRES_USER=pulseboard
POSTGRES_DB=pulseboard
REDIS_EVENT_CHANNEL=pulseboard:events
JWT_EXPIRES_IN=12h
EVENT_FEED_SIZE=50

# A demo account, created on first boot. Leave both empty for a real
# deployment; set them if the point is to hand someone a working login.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Traffic shape and alert thresholds.
PRODUCER_INTERVAL_MS=450
PRODUCER_BURST_FACTOR=1
ALERT_REVENUE_SPIKE=20000
ALERT_REVENUE_DROP=2000
ALERT_ORDERS_SURGE=40
